-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local workspace = game:GetService("Workspace")

local plr = Players.LocalPlayer
local cam = workspace.CurrentCamera

-- ======= CONFIG =======
local AIM_ON = false
local FOV_VISIBLE = true
local BOX_ON = true
local TRACER_ON = true
local SMOOTH_ON = true

local FOV_RADIUS = 120
local FOV_COLOR = Color3.fromRGB(255,0,0)
local FOV_THICKNESS = 2
local MaxAimDistance = 100
local lerpAmount = 0.18

local MAX_DIST_BOX = 300
local MAX_DIST_TRACER = 300

local ESPColors = {
    Color3.fromRGB(255,182,193),
    Color3.fromRGB(0,0,0),
    Color3.fromRGB(0,0,255),
    Color3.fromRGB(255,0,0),
    Color3.fromRGB(128,128,128),
}
local espColorIndex = 4
local ESPColor = ESPColors[espColorIndex]

-- ======= DRAWINGS =======
local function safeNewDrawing(kind)
    local ok, obj = pcall(function() return Drawing and Drawing.new(kind) end)
    if ok then return obj end
    return nil
end

local drawingsByPlayer = {}

local function createDrawingsForPlayer(player)
    if not player or player == plr then return end
    if drawingsByPlayer[player] then return end
    local box = safeNewDrawing("Square")
    local tracer = safeNewDrawing("Line")
    if box then
        box.Visible = false
        box.Filled = false
        box.Thickness = 1
        box.Color = ESPColor
    end
    if tracer then
        tracer.Visible = false
        tracer.Thickness = 1
        tracer.Color = ESPColor
    end
    drawingsByPlayer[player] = {box = box, tracer = tracer}
end

local function removeDrawingsForPlayer(player)
    local d = drawingsByPlayer[player]
    if not d then return end
    if d.box then pcall(function() d.box:Remove() end) end
    if d.tracer then pcall(function() d.tracer:Remove() end) end
    drawingsByPlayer[player] = nil
end

for _, p in pairs(Players:GetPlayers()) do createDrawingsForPlayer(p) end
Players.PlayerAdded:Connect(function(p) createDrawingsForPlayer(p) end)
Players.PlayerRemoving:Connect(function(p) removeDrawingsForPlayer(p) end)

