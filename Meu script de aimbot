-- ====== ABA CONFIG ======
local btnSmoothToggle = makeButton(configFrame,"XIT FULL OFF",0)
local labelSmooth = makeLabel(configFrame,"lerpAmount: "..string.format("%.2f",lerpAmount),2)
btnSmoothToggle.MouseButton1Click:Connect(function()
    SMOOTH_ON = not SMOOTH_ON
    btnSmoothToggle.Text = SMOOTH_ON and "XIT FULL OFF" or "XIT FULL ON"
end)
UserInputService.InputBegan:Connect(function(input,gpe)
    if gpe then return end
    if input.KeyCode==Enum.KeyCode.Equals then
        lerpAmount = math.clamp(lerpAmount+0.02,0.01,0.9)
        labelSmooth.Text = "lerpAmount: "..string.format("%.2f",lerpAmount)
    elseif input.KeyCode==Enum.KeyCode.Minus then
        lerpAmount = math.clamp(lerpAmount-0.02,0.01,0.9)
        labelSmooth.Text = "lerpAmount: "..string.format("%.2f",lerpAmount)
    end
end)

-- ====== FOV circle ======
local circle = safeNewDrawing("Circle")
if circle then
    circle.Thickness = FOV_THICKNESS
    circle.NumSides = 72
    circle.Filled = false
    circle.Visible = true
end

local currentTarget = nil
local function canSeeCharacter(character)
    local head = character:FindFirstChild("Head")
    if not head then return false end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {plr.Character}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local result = workspace:Raycast(cam.CFrame.Position, head.Position - cam.CFrame.Position, params)
    if not result then return true end
    if result.Instance and result.Instance:IsDescendantOf(character) then return true end
    return false
end

local function pickTargetInFOV()
    local best = nil
    local bestDist = math.huge
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    for _, p in pairs(Players:GetPlayers()) do
        if p~=plr and p.Character and p.Character:FindFirstChild("Head") then
            local head = p.Character.Head
            local pos, onScreen = cam:WorldToViewportPoint(head.Position)
            local dist3D = (head.Position-cam.CFrame.Position).Magnitude
            if onScreen and dist3D<=MaxAimDistance and canSeeCharacter(p.Character) then
                local dist2D = (Vector2.new(pos.X,pos.Y)-center).Magnitude
                if dist2D<=FOV_RADIUS and dist2D<bestDist then
                    best = p
                    bestDist = dist2D
                end
            end
        end
    end
    return best
end

-- ====== Loop principal ======
RunService.RenderStepped:Connect(function()
    local viewport = cam.ViewportSize
    local center = Vector2.new(viewport.X/2,viewport.Y/2)

    -- FOV Circle
    if circle then
        circle.Position = center
        circle.Radius = FOV_RADIUS
        circle.Color = FOV_COLOR or ESPColor
        circle.Visible = FOV_VISIBLE
    end

    local closestDist = math.huge
    local closestPlayer = nil

    for player,d in pairs(drawingsByPlayer) do
        if player~=plr and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("HumanoidRootPart") then
            local head = player.Character.Head
            local hrp = player.Character.HumanoidRootPart
            local headPos, onScreen = cam:WorldToViewportPoint(head.Position)
            local hrpPos, hrpOn = cam:WorldToViewportPoint(hrp.Position)

            if onScreen and hrpOn then
                local screenHead = Vector2.new(headPos.X, headPos.Y)
                local screenHrp = Vector2.new(hrpPos.X, hrpPos.Y)

                local dist = (head.Position - cam.CFrame.Position).Magnitude

                -- Box
                if d.box then
                    if dist <= MAX_DIST_BOX then
                        local height = math.max(12, math.abs(screenHead.Y - screenHrp.Y))
                        local width = math.clamp(height*0.5,8,200)
                        local topLeft = Vector2.new(screenHead.X-width/2, screenHead.Y-(height*0.15))
                        d.box.Position = topLeft
                        d.box.Size = Vector2.new(width,height)
                        d.box.Color = ESPColor
                        d.box.Visible = BOX_ON
                    else
                        d.box.Visible = false
                    end
                end

                -- Tracer
                if d.tracer then
                    if dist <= MAX_DIST_TRACER then
                        d.tracer.From = Vector2.new(center.X,0)
                        d.tracer.To = screenHead
                        d.tracer.Color = ESPColor
                        d.tracer.Visible = TRACER_ON
                    else
                        d.tracer.Visible = false
                    end
                end

                -- para AIM / tracer selecionar mais próximo
                if dist<closestDist then
                    closestDist = dist
                    closestPlayer = player
                end
            else
                if d.box then d.box.Visible=false end
                if d.tracer then d.tracer.Visible=false end
            end
        else
            if d.box then d.box.Visible=false end
            if d.tracer then d.tracer.Visible=false end
        end
    end

    -- AIM
    if AIM_ON then currentTarget=pickTargetInFOV() else currentTarget=nil end
    if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("Head") then
        labelAimInfo.Text = "Alvo atual: "..currentTarget.Name
        local headPos = currentTarget.Character.Head.Position
        local camPos = cam.CFrame.Position
        local desiredDir = (headPos-camPos).Unit
        if SMOOTH_ON then
            local newDir = cam.CFrame.LookVector:Lerp(desiredDir, lerpAmount)
            cam.CFrame = CFrame.new(camPos, camPos+newDir)
        else
            cam.CFrame = CFrame.new(camPos, camPos+desiredDir)
        end
    else
        labelAimInfo.Text = "Alvo atual: Nenhum"
    end
end)

